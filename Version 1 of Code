;======================================================
; TRAFFIC LIGHT: By Cesar Juarez Vasquez, Kevin Vargas, and Camila Vaca
; ATmega328P - 16Mhz
;
; Green:  5 seconds, then yellow.      
; Yellow: 3 seconds, then red.
; Red: 5 seconds, then green.
; clear/crosswalk: blink every 1s for 5s after button pressed 
;
; forever repeat
; Not completed work

;======================================================







;-------------------------------------------------------------------

.include "m328pdef.inc"

.org 0x0000                             ; Reset Vector 
          jmp       RESET

.org INT0addr                           
          jmp       faster_isr

.org OC1Aaddr                           ; Timer Counter1 Compare Match A, used to set timing between red, yellow, and green light 
          jmp       t1_ctc_isr 

.org INT_VECTORS_SIZE                   ; end vector table 

; Main Program 
;-------------------------------------------------------------------

RESET: 
          ; one-time configuration
          ldi       r16,high(RAMEND)
          out       SPH,r16
          ldi       r16,low(RAMEND)                                      
          out       SPL,r16 

          ; config GPIO
          sbi       DDRB,DDB0           ; Red LED output
          sbi       DDRB,DDB1           ; Yellow LED output        
          sbi       DDRB,DDB2           ; Green LED output
          cbi       DDRC,DDC0           ; Crosswalk LED input 



          call      set_green           ; so that green can starts on 

          


;-------------------------------------------------------------------
set_green: 
          sbi       PORTB,PB2           ; to turn green ON 
          cbi       PORTB,PB0           ; to keep red OFF
          cbi       PORTB,PB1           ; to keep yellow OFF
          cbi       PORTC,PC0           ; high-imp | to keep crosswalk light OFF unless button is pressed 

          ldi       counter, 0          ; time counter

          ldi       r16, (1<<WGM12)     ; ctc mode
          sts       TCCR1B, r16

          ldi       r16, HIGH(15624)    ; compare value 15624 = 1s interrupt
          sts       OCR1AH, r16

          ldi       r16, LOW(15624)
          sts       OCR1AL, r16

          ldi       r16, (1<<OCIE1A)    ; Enable Timer1 compare match a interrupt
          sts       TIMSK1, r16

          ldi       r16, (1<<WGM12)|(1<<CS12)|(1<<CS10)     ; Start timer1 with prescaler 1024
          sts       TCCR1B, r16

          sei                           ; Enable global interrupts
                     
          ret
;-------------------------------------------------------------------
main:
          rjmp main



;-------------------------------------------------------------------
set_yellow:
          sbi       PORTB,PB1           ; to turn yellow ON 
          cbi       PORTB,PB2           ; to keep green OFF
          cbi       PORTB,PB0           ; to keep red OFF 
          cbi       PORTC,PC0           ; to keep crosswalk light OFF 

          ret
;-------------------------------------------------------------------
set_red:
          sbi       PORTB,PB0           ; to turn red ON 
          cbi       PORTB,PB2           ; to keep green OFF 
          cbi       PORTB,PB1           ; to keep yellow OFF 
          
          cpi       r20,1               ; checks the button flag
          brne      skip_walk
          sbi       PORTC,PC0           ; if pressed crosswalk turned ON 
          clr       r20
;-------------------------------------------------------------------
Crosswalk_isr:                          ; LED blinks every 0.5s for 5s when button is pressed
          cli       DDRC,DDC0           ; sets crosswalk on input mode, awaiting button press.
          sbi       PORTC,PC0           ; Internal pull-up

          in        r17, PINC           ; Read PINC
          SBRS      r17, PINC0          ; skip if PC0 = 1

          BRNE      Else                ; false -> skip the if-body








          reti                          ; End of isr

;-------------------------------------------------------------------
t1_ctc_isr:
          inc counter

          cpi counter, 5                ; counter makes an interrupt every second depending of what light is on.
          brne EXIT_ISR

          brne ELSE
          cbi PORTB, PORTB2             ; turn green off

          sbi PORTB, PORTB1             ; turn yellow on

          ldi r16, 0                    ; stop timer 1
          sts TCCR1B, r16
          rjmp DONE
          ELSE:

          DONE:
          

EXIT_ISR:
          reti



;-------------------------------------------------------------------


skip_walk:
          ret


